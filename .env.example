# Required for deployed environments. Must be the host-only HTTPS backend origin.
VITE_API_BASE_URL="https://api.kairoid.com"

# Optional. Defaults to off in production and on in non-production unless explicitly set.
VITE_GOOGLE_SSO_ENABLED="false"

# Marketing site used by auth and shell links.
VITE_MARKETING_WEBSITE_URL="https://kairoid.com"
